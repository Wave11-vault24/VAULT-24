{
  "name": "vault24",
  "version": "1.0.0",
  "description": "Vault24 Bank — fictional digital banking backend (hackathon prototype)",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "db:migrate": "node scripts/migrate.js",
    "db:create-admin": "node scripts/create-admin.js",
    "test": "NODE_ENV=test jest --runInBand",
    "db:seed": "node scripts/seed.js",
    "db:reset": "node scripts/seed.js --reset",
    "test:coverage": "NODE_ENV=test jest --runInBand --coverage",
    "test:report": "NODE_ENV=test jest --runInBand --coverage --coverageReporters=json-summary --coverageReporters=text-summary --json --outputFile=coverage/test-results.json; node scripts/test-report.js",
    "check:frontend": "node scripts/check-frontend.js",
    "test:e2e": "playwright test",
    "test:e2e:report": "mkdir -p coverage && node scripts/check-frontend.js > coverage/frontend-check.txt; playwright test; node scripts/e2e-report.js",
    "test:all": "npm run check:frontend && npm test && npm run test:e2e"
  },
  "dependencies": {
    "argon2": "^0.45.1",
    "better-sqlite3": "^13.0.3",
    "cors": "^2.8.6",
    "dotenv": "^18.0.8",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.1",
    "express-session": "^1.19.0",
    "helmet": "^8.3.0",
    "multer": "^2.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.56.0",
    "jest": "^30.5.2",
    "nodemon": "^3.1.14",
    "supertest": "^7.3.1"
  },
  "private": true,
  "engines": {
    "node": ">=20"
  },
  "jest": {
    "testEnvironment": "node",
    "testMatch": [
      "**/tests/**/*.test.js"
    ],
    "collectCoverageFrom": [
      "src/**/*.js",
      "!src/server.js"
    ]
  }
}
